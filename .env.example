APP_NAME="Clip Adem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clip
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@clip-adem.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Clés de test Cloudflare officielles : valident toujours, sans appel réseau
# ni compte à créer. Remplacer par les clés du tableau de bord Cloudflare
# (dash.cloudflare.com/?to=/:account/turnstile) avant la mise en production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Passages obligés du parcours. Les passer à false permet de parcourir
# l'interface sans obstacle en développement ; ils doivent rester à true en
# production.
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_COMPLETE_PROFILE=true
REQUIRE_ADMIN_2FA=true
REQUIRE_CREATOR_VALIDATION=true
REQUIRE_FUNDED_CAMPAIGNS=true

# Réseaux sociaux. Tant qu'une plateforme n'a pas ses identifiants, un
# fournisseur simulé prend le relais hors développement — en production,
# leur absence est une erreur au démarrage, pas un mode dégradé silencieux.
#
# TikTok : enregistrez une application **Web**, pas Desktop. Le parcours
# desktop n'accepte que localhost comme adresse de retour et impose PKCE ;
# il ne pourrait donc jamais servir en production.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DAILY_QUOTA=
# Doivent correspondre aux portées activées dans la console TikTok.
TIKTOK_SCOPES=user.info.basic,video.list
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Adresse de retour OAuth. À laisser vide en local : elle est alors déduite
# de la route. À figer dès qu'un tunnel s'intercale, parce que le
# fournisseur la compare caractère par caractère avec celle enregistrée.
# Elle doit finir par /oauth/<plateforme>/callback
TIKTOK_REDIRECT_URI=
YOUTUBE_REDIRECT_URI=
INSTAGRAM_REDIRECT_URI=

# Proxys de confiance. Vide en local. Derrière un tunnel de développement,
# Cloudflare ou un répartiteur de charge : TRUSTED_PROXIES=*
# Sans ça, TLS terminé en amont fait fabriquer des URL http:// à Laravel,
# et l'adresse de retour OAuth ne correspond plus à celle enregistrée.
TRUSTED_PROXIES=

# Connexion Google. Console Google Cloud > Identifiants > ID client OAuth,
# type « Application Web ». URI de redirection autorisée, à l'identique :
# https://votre-domaine/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Parrainage. Le taux est en points de base : 500 = 5 %. La commission est
# payée par la plateforme sur sa marge, jamais prélevée sur le budget d'une
# campagne ni sur les gains du filleul.
REFERRALS_ENABLED=true
REFERRAL_RATE_BP=500
