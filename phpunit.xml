<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            MySQL et non SQLite, volontairement : SQLite ne verrouille pas au
            niveau ligne, lockForUpdate() y est un no-op silencieux. Un moteur
            de budget testé sur SQLite passerait tous les tests de concurrence
            sans rien garantir en production.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="clip_testing"/>
        <env name="DB_URL" value=""/>
        <!--
            Les passages obligés du parcours restent actifs pendant les tests,
            même quand ils sont suspendus en développement : c'est ce qui évite
            qu'un contrôle désactivé « le temps de voir l'interface » parte en
            production sans que personne ne s'en aperçoive.
        -->
        <env name="REQUIRE_EMAIL_VERIFICATION" value="true"/>
        <env name="REQUIRE_COMPLETE_PROFILE" value="true"/>
        <env name="REQUIRE_ADMIN_2FA" value="true"/>
        <env name="REQUIRE_CREATOR_VALIDATION" value="true"/>
        <env name="REQUIRE_FUNDED_CAMPAIGNS" value="true"/>
        <env name="REFERRALS_ENABLED" value="true"/>
        <env name="REFERRAL_RATE_BP" value="500"/>

        <!--
            Captcha neutralisé : un client de test ne peut pas résoudre un défi
            Cloudflare, et la suite ne doit pas dépendre du fait que la machine
            du développeur ait des clés dans son .env. Que le captcha morde
            réellement quand il est configuré est vérifié par un test qui pose
            la clé lui-même (RegistrationTest).
        -->
        <env name="TURNSTILE_SITE_KEY" value=""/>
        <env name="TURNSTILE_SECRET_KEY" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
