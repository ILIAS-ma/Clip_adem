 import fs from 'node:fs';
 import path from 'node:path';
+import { AsyncLocalStorage } from 'node:async_hooks';
 import { fileURLToPath } from 'node:url';
 
 export const ROOT = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
 
+/**
+ * Le clippeur de la requete en cours.
+ *
+ * AsyncLocalStorage plutot qu'un parametre passe de fonction en fonction :
+ * les dossiers sont resolus a une quarantaine d'endroits, dont le fond de
+ * lib/render.js et lib/series.js. Les traverser tous avec un identifiant
+ * aurait touche chaque signature, et un seul oubli aurait ecrit dans
+ * l'espace de quelqu'un d'autre sans que rien ne le signale.
+ */
+export const clippeurCourant = new AsyncLocalStorage();
+
+/**
+ * Identifiant utilisable comme nom de dossier.
+ *
+ * Liste blanche stricte, jamais un simple echappement : l'identifiant vient
+ * d'un en-tete HTTP, et '..' suffirait a sortir de l'espace. Tout ce qui
+ * n'est pas une lettre, un chiffre ou un tiret disparait.
+ */
+export function identifiantPropre(brut) {
+  const propre = String(brut || '').toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 40);
+
+  return propre || 'commun';
+}
+
+/**
+ * La racine de l'espace du clippeur en cours.
+ *
+ * Hors requete — demarrage, taches de fond — on retombe sur un espace
+ * commun plutot que sur la racine du projet : un fichier ecrit a cote du
+ * code s'y retrouve melange aux sources.
+ */
+export function espaceRacine() {
+  const id = clippeurCourant.getStore();
+  const dir = path.join(ROOT, 'espaces', identifiantPropre(id));
+
+  fs.mkdirSync(dir, { recursive: true });
+
+  return dir;
+}
+
